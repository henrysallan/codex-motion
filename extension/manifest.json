{
  "manifest_version": 3,
  "name": "motion.isthishenry.chrome",
  "version": "0.3.0",
  "description": "Pull video design references from any page into codex-motion. Click the icon, hover a video, click to grab it.",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "motion.isthishenry — pick a video (Alt+Shift+V)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "downloads", "nativeMessaging"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Start the video picker"
    }
  }
}
